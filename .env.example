# RazorMesh Trust — Phase 1 local environment template.
# Copy to `.env` and adjust. NEVER put real secrets here or in `.env`.
# All Phase-1 values are local-only placeholders; no external credentials exist in Phase 1.

# PostgreSQL (Docker Compose binds 127.0.0.1:15432; host 5432 is reserved by an
# unrelated local PostgreSQL that must not be touched)
DATABASE_URL=postgresql+psycopg://razormesh:CHANGE_ME_LOCAL_ONLY@127.0.0.1:15432/razormesh

# Redis (Docker Compose binds 127.0.0.1:16379)
REDIS_URL=redis://127.0.0.1:16379/0

# Local Ed25519 dev signing keys (generated by scripts/generate_dev_keys.py;
# private key is gitignored and must never leave this machine)
DEV_TICKET_PRIVATE_KEY_PATH=./infra/keys/dev_ticket_ed25519_private.pem
DEV_TICKET_PUBLIC_KEY_PATH=./infra/keys/dev_ticket_ed25519_public.pem

# API
API_HOST=127.0.0.1
API_PORT=8000

# Frontend origin used by backend CORS (dev only)
WEB_ORIGIN=http://localhost:3000

# RazorGuard policy version embedded in decisions/tickets
POLICY_VERSION=phase1-policy-v1

# Mock payment provider flag — must remain true in Phase 1
MOCK_PAYMENT_PROVIDER=true
