# RazorMesh Trust — Phase 1 local environment template.
# Copy to `.env` and adjust. NEVER put real secrets here or in `.env`.
# All Phase-1 values are local-only placeholders; no external credentials exist in Phase 1.

# PostgreSQL (Docker Compose binds 127.0.0.1:15432; host 5432 is reserved by an
# unrelated local PostgreSQL that must not be touched)
DATABASE_URL=postgresql+psycopg://razormesh:CHANGE_ME_LOCAL_ONLY@127.0.0.1:15432/razormesh

# Redis (Docker Compose binds 127.0.0.1:16379)
REDIS_URL=redis://127.0.0.1:16379/0

# Local Ed25519 dev signing keys (generated by scripts/generate_dev_keys.py;
# private key is gitignored and must never leave this machine)
DEV_TICKET_PRIVATE_KEY_PATH=./infra/keys/dev_ticket_ed25519_private.pem
DEV_TICKET_PUBLIC_KEY_PATH=./infra/keys/dev_ticket_ed25519_public.pem

# API
API_HOST=127.0.0.1
API_PORT=8000

# Frontend origin used by backend CORS (dev only)
WEB_ORIGIN=http://localhost:3000

# RazorGuard policy version embedded in decisions/tickets
POLICY_VERSION=phase1-policy-v1

# Mock payment provider flag — canonical selector is PAYMENT_PROVIDER below;
# this legacy flag stays in sync for Phase-1 compatibility
MOCK_PAYMENT_PROVIDER=true

# ---------------------------------------------------------------------------
# Phase 2 — Razorpay TEST MODE ONLY (Live Mode is forbidden and rejected)
# ---------------------------------------------------------------------------
# Canonical provider selector: "mock" (default, credential-free) or "razorpay".
PAYMENT_PROVIDER=mock

# Must be exactly "test". Any live configuration refuses to start.
RAZORPAY_MODE=test

# PUBLIC Key ID — safe for the browser checkout launch payload.
RAZORPAY_KEY_ID=

# BACKEND-ONLY secrets. Never expose to the browser, never commit, never log.
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Razorpay REST base (leave default), bounded request timeout seconds,
# local webhook route, and the public tunnel URL configured in the Dashboard.
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_REQUEST_TIMEOUT_SECONDS=10
RAZORPAY_WEBHOOK_PATH=/api/v1/webhooks/razorpay
RAZORPAY_WEBHOOK_PUBLIC_URL=

# --- Phase 3: Intent Compiler via TokenRouter (backend only; never NEXT_PUBLIC) ---
# Obtain a key at https://www.tokenrouter.io (gateway keys look like tr_...).
# TOKENROUTER_API_KEY=
# Documented base URL per R-019 (official docs); see PHASE3_STATUS M10 probe.
# TOKENROUTER_BASE_URL=
# Planner model id, e.g. the free Qwen variant listed in your TokenRouter catalog.
# PLANNER_MODEL=
